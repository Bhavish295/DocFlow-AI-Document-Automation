APP_NAME=Document Workflow Automation
APP_ENV=development
DEBUG=true
# When unset: docs enabled in development, disabled in production
# ENABLE_DOCS=true
API_V1_PREFIX=/api/v1

# PostgreSQL connection string
# Local development (host Postgres):
#   postgresql+psycopg2://USER:PASSWORD@localhost:5432/DATABASE
# Docker Compose (backend container):
#   postgresql+psycopg2://USER:PASSWORD@postgres:5432/DATABASE
# Do not hard-code "postgres" into application source — set via environment.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/docflow

# Comma-separated list of allowed frontend origins (never use * with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Local file storage (relative to backend/ unless absolute)
UPLOAD_DIR=storage/uploads

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=25

# Optional full path to the Tesseract executable (required on Windows if not on PATH)
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Tesseract language data code
OCR_LANGUAGE=eng

# If selectable PDF text is shorter than this, OCR is used as a fallback
PDF_TEXT_MIN_CHARS=40

# Allowed numeric difference when comparing invoice and PO amounts
VALIDATION_AMOUNT_TOLERANCE=0.01

# RAG / embeddings / LLM (no secrets in defaults)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
LLM_PROVIDER=extractive
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE=

# Read-only SQL business data assistant
SQL_GENERATOR_PROVIDER=deterministic
SQL_MAX_ROWS=100
SQL_MAX_QUERY_LENGTH=5000
SQL_MAX_QUESTION_LENGTH=1000
SQL_QUERY_TIMEOUT_SECONDS=10

# Controlled workflow engine
WORKFLOW_CONFIDENCE_THRESHOLD=0.7
WORKFLOW_MAX_DEPTH=2
WORKFLOW_DEDUP_ENABLED=true

# Local ML anomaly detection (IsolationForest)
ANOMALY_MODEL_NAME=isolation_forest
ANOMALY_MODEL_VERSION=1.0.0
ANOMALY_MIN_TRAINING_SAMPLES=10
ANOMALY_CONTAMINATION=0.1
ANOMALY_RANDOM_STATE=42
ANOMALY_N_ESTIMATORS=100
ANOMALY_NORMAL_MAX=0.35
ANOMALY_UNUSUAL_MAX=0.55
ANOMALY_ANOMALY_MAX=0.75
ANOMALY_MODEL_DIR=storage/anomaly_models

# Duplicate detection (local SHA-256 / business / similarity)
DUPLICATE_SIMILARITY_THRESHOLD=0.85
DUPLICATE_BUSINESS_AMOUNT_TOLERANCE=0.01
DUPLICATE_MAX_SIMILARITY_CANDIDATES=50
# Run duplicate detection automatically after each document is processed
DUPLICATE_AUTO_CHECK_ENABLED=true

# Local ML document classification (TF-IDF + LogisticRegression)
CLASSIFICATION_MODEL_DIR=storage/models
CLASSIFICATION_MODEL_VERSION=1.3.0
CLASSIFICATION_RANDOM_STATE=42

# Authentication / JWT (local only — change secrets for any shared environment)
# Production (APP_ENV=production) rejects insecure / short JWT secrets at startup.
AUTH_JWT_SECRET=change-me-in-production-docflow-jwt-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480
# Create the first admin only when the users table is empty
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Batch ingestion (Step 22) — max files per POST /api/v1/ingestion/batch
INGESTION_MAX_BATCH_FILES=20

# Controlled agent (Step 23) — bounded tool orchestration
AGENT_MAX_STEPS=8
AGENT_HARD_MAX_STEPS=10
AGENT_MAX_QUESTION_LENGTH=1000

# When True, document processing runs inline (tests). False = BackgroundTasks or Celery.
DOCUMENT_PROCESSING_SYNC=false

# --- Step 27 workers / email ---
# local = FastAPI BackgroundTasks (default for local dev without Redis)
# celery = Redis + Celery worker
PROCESSING_WORKER_MODE=local
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_DELAY_SECONDS=30

# Email ingestion: none | mock | imap (no OAuth; IMAP is provider-neutral)
EMAIL_PROVIDER=none
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
EMAIL_IMAP_USE_SSL=true
EMAIL_POLL_INTERVAL_SECONDS=300

# --- Step 26 security / hardening ---
# Enable only behind HTTPS in real production
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=31536000
# Reject requests larger than this (Content-Length), MB
MAX_REQUEST_BODY_MB=30
# In-process rate limits (per client IP / minute). Single-instance only — Redis later.
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=30
# Password rules for newly created/updated users (bootstrap admin is exempt)
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_LETTER=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=false
# Login failure cooldown (per username/email)
AUTH_LOGIN_MAX_FAILURES=8
AUTH_LOGIN_LOCKOUT_SECONDS=300
