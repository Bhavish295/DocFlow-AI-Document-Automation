# Copy to .env.docker for `docker compose` (never commit real secrets).
# Used as env_file for the backend service. Compose also substitutes
# POSTGRES_* into DATABASE_URL from this file when present as a project .env,
# or from your shell. Prefer setting values here and also copying key
# POSTGRES_* into a root `.env` for compose interpolation, or export them.

# --- Application ---
APP_NAME=Document Workflow Automation
APP_ENV=production
DEBUG=false
# OpenAPI UI off in production-like Docker (set true only for local debugging)
ENABLE_DOCS=false
API_V1_PREFIX=/api/v1

# --- PostgreSQL (must match docker-compose / DATABASE_URL host "postgres") ---
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=change-me-strong-db-password

# DATABASE_URL is overridden in docker-compose.yml to use host "postgres".
# Keep a matching local reference here for documentation only if needed:
# DATABASE_URL=postgresql+psycopg2://docflow:change-me-strong-db-password@postgres:5432/docflow

# Browser origins allowed for credentialed CORS (frontend mapped to host :5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (REQUIRED in production) ---
# Generate a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Set once to create the first admin when the users table is empty
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-bootstrap-password

# --- Storage / uploads ---
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=25

# --- OCR (Tesseract is installed in the backend image) ---
TESSERACT_CMD=
OCR_LANGUAGE=eng
PDF_TEXT_MIN_CHARS=40

# --- Jobs ---
DOCUMENT_PROCESSING_SYNC=false

# --- RAG / embeddings / LLM ---
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
LLM_PROVIDER=extractive
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE=

# --- SQL agent ---
SQL_GENERATOR_PROVIDER=deterministic
SQL_MAX_ROWS=100
SQL_MAX_QUERY_LENGTH=5000
SQL_MAX_QUESTION_LENGTH=1000
SQL_QUERY_TIMEOUT_SECONDS=10

# --- Workflows ---
WORKFLOW_CONFIDENCE_THRESHOLD=0.7
WORKFLOW_MAX_DEPTH=2
WORKFLOW_DEDUP_ENABLED=true

# --- Anomaly detection ---
ANOMALY_MODEL_NAME=isolation_forest
ANOMALY_MODEL_VERSION=1.0.0
ANOMALY_MIN_TRAINING_SAMPLES=10
ANOMALY_CONTAMINATION=0.1
ANOMALY_RANDOM_STATE=42
ANOMALY_N_ESTIMATORS=100
ANOMALY_NORMAL_MAX=0.35
ANOMALY_UNUSUAL_MAX=0.55
ANOMALY_ANOMALY_MAX=0.75
ANOMALY_MODEL_DIR=storage/anomaly_models

# --- Duplicates ---
DUPLICATE_SIMILARITY_THRESHOLD=0.85
DUPLICATE_BUSINESS_AMOUNT_TOLERANCE=0.01
DUPLICATE_MAX_SIMILARITY_CANDIDATES=50

# --- Classification ---
CLASSIFICATION_MODEL_DIR=storage/models
CLASSIFICATION_MODEL_VERSION=1.2.0
CLASSIFICATION_RANDOM_STATE=42

# --- Ingestion / agent ---
INGESTION_MAX_BATCH_FILES=20
AGENT_MAX_STEPS=8
AGENT_HARD_MAX_STEPS=10
AGENT_MAX_QUESTION_LENGTH=1000
VALIDATION_AMOUNT_TOLERANCE=0.01

# --- Step 27 workers / email ---
PROCESSING_WORKER_MODE=celery
REDIS_URL=redis://redis:6379/0
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_DELAY_SECONDS=30
EMAIL_PROVIDER=none
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
EMAIL_IMAP_USE_SSL=true
EMAIL_POLL_INTERVAL_SECONDS=300

# --- Step 26 security / hardening ---
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=31536000
MAX_REQUEST_BODY_MB=30
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=30
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_LETTER=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=false
AUTH_LOGIN_MAX_FAILURES=8
AUTH_LOGIN_LOCKOUT_SECONDS=300
