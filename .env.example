# Root env file used by Docker Compose for variable substitution (${POSTGRES_*}, etc.).
# Copy to `.env` (gitignored) when using docker compose.
# Application secrets for the backend container belong in `.env.docker`.

POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=change-me-strong-db-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
